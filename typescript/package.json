{
  "name": "x402-avm_monorepo",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.7.0"
  },
  "packageManager": "pnpm@10.7.0",
  "private": "true",
  "version": "0.0.2",
  "description": "x402 Payment Protocol with Algorand integration - Monorepo",
  "main": "index.js",
  "pnpm": {
    "overrides": {
      "cssstyle": "5.3.6"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "lint:check": "turbo run lint:check",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @x402-avm/core --filter @x402-avm/evm --filter @x402-avm/svm --filter @x402-avm/avm --filter @x402-avm/aptos --filter @x402-avm/stellar test:integration",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "keywords": ["x402", "payment", "protocol", "algorand", "avm"],
  "author": "GoPlausible",
  "license": "Apache-2.0",
  "repository": "https://github.com/GoPlausible/x402-avm",
  "homepage": "https://x402.goplausible.xyz",
  "devDependencies": {
    "tsup": "^8.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "@changesets/cli": "^2.28.1",
    "@changesets/changelog-github": "^0.5.1"
  }
}